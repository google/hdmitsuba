#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "root"
{
    def Xform "Camera"
    {
        float3 xformOp:rotateXYZ = (63.559296, 2.2983238e-7, 46.691944)
        double3 xformOp:translate = (4.8382463455200195, -4.495369911193848, 3.1569976806640625)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def Camera "Camera"
        {
            float2 clippingRange = (0.1, 100)
            float focalLength = 0.5
            float horizontalAperture = 0.36
            token projection = "perspective"
            float verticalAperture = 0.36
        }
    }

    def Points "VertexColors"
    {
        point3f[] points = [(-1.2, -0.6, 0), (-0.4, -0.9, 0.2), (0.4, -1.2, 0), (1.2, -1.5, 0.3)]
        float[] widths = [0.3, 0.5, 0.7, 0.9] (
            interpolation = "vertex"
        )
        color3f[] primvars:displayColor = [(0.9, 0.1, 0.1), (0.1, 0.8, 0.2), (0.2, 0.3, 0.9), (0.9, 0.8, 0.1)] (
            interpolation = "vertex"
        )
    }

    def Points "SingleVertexColor"
    {
        point3f[] points = [(0.3, 0, 0.1)]
        float[] widths = [0.5] (
            interpolation = "vertex"
        )
        color3f[] primvars:displayColor = [(0.8, 0.3, 0.7)] (
            interpolation = "vertex"
        )
    }

    # Invisible to the camera.
    def Points "Secondary"
    {
        point3f[] points = [(0.9, -0.2, 0.1)]
        token primvars:mitsuba:visibility = "secondary"
        float[] widths = [0.5] (
            interpolation = "vertex"
        )
    }

    # Instanced points, whose `widths` primvar overrides the attribute.
    def PointInstancer "Instancer"
    {
        point3f[] positions = [(-1.7, 0.1, 0.5), (2.0, -0.5, 0.5)]
        int[] protoIndices = [0, 0]
        rel prototypes = </root/Instancer/Prototype>

        def Points "Prototype"
        {
            point3f[] points = [(0, 0, 0), (0, 0, 0.35)]
            float[] primvars:widths = [0.3, 0.2] (
                interpolation = "vertex"
            )
            float[] widths = [1, 1]
        }
    }

    def Points "ConstantColor"
    {
        point3f[] points = [(-0.8, 0.8, 0), (0.2, 1.0, 0.3)]
        float[] widths = [0.6] (
            interpolation = "constant"
        )
        color3f[] primvars:displayColor = [(0.1, 0.6, 0.6)]
        double3 xformOp:scale = (1, 1.5, 0.7)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Points "Material" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        point3f[] points = [(1.4, 1.2, 0.2)]
        rel material:binding = </root/_materials/Red>
    }

    def Scope "_materials"
    {
        def Material "Red"
        {
            token outputs:surface.connect = </root/_materials/Red/Principled_BSDF.outputs:surface>

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.06, 0.07)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def DomeLight "Environment"
    {
        float inputs:intensity = 0.3
    }

    def Xform "Light"
    {
        double3 xformOp:translate = (4.0, 1.0, 5.9)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def SphereLight "Light"
        {
            float inputs:intensity = 318.30988
            bool inputs:normalize = 1
            float inputs:radius = 0.1
        }
    }
}
