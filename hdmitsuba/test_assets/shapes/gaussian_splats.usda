def Scope "Render"
{
    # Gaussian splats need the volumetric radiance-field integrator; the
    # default 'path' integrator does not intersect ellipsoid primitives and
    # renders black. Authoring it here lets the generic render test pick this
    # scene up without a special case.
    def RenderSettings "PrimarySettings"
    {
        custom string mitsuba:integrator:type = "volprim_rf_basic"
    }
}
