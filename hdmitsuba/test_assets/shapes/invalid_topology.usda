#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    subLayers = [@./cube.usda@]
    upAxis = "Z"
)

over "root"
{
    # Encloses the cube, but its face vertex indices exceed its points.
    def Mesh "Invalid"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 4, 6, 2, 3, 2, 6, 7, 7, 6, 4, 5, 5, 1, 3, 7, 1, 0, 2, 3, 5, 4, 0, 1]
        point3f[] points = [(1.5, 1.5, 1.5), (1.5, 1.5, -1.5), (1.5, -1.5, 1.5), (1.5, -1.5, -1.5)]
        uniform token subdivisionScheme = "none"
    }
}
