#usda 1.0
(
    doc = """area.usda with a non-uniformly scaled CylinderLight."""
    defaultPrim = "root"
)

def Xform "root" (
    prepend references = @./area.usda@
)
{
    over "Area"
    {
        float3 xformOp:scale = (0.6, 0.9, 0.45)

        def CylinderLight "Area"
        {
            float inputs:length = 1.5
            float inputs:radius = 0.2
        }
    }
}
