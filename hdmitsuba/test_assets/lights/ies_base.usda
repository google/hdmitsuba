#usda 1.0
(
    doc = """Floor lit from 1 m above by a small light at `/light` with the
    asymmetric IES profile, seen by a top-down camera. The light points down
    (-Z) and is rotated about its emission axis, so that any rotation or
    mirroring of the IES light frame is visible on the floor. Sublayered by the
    `ies_*.usda` scenes, which define `/light`."""
    metersPerUnit = 1
    upAxis = "Z"
)

def Mesh "floor"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
}

def Camera "camera"
{
    float focalLength = 25
    double3 xformOp:translate = (0, 0, 4)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
