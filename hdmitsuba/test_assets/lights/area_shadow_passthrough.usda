#usda 1.0
(
    defaultPrim = "root"
    upAxis = "Z"
)

def Xform "root"
{
    def Camera "Camera"
    {
        float focalLength = 0.5
        float horizontalAperture = 0.36
        float verticalAperture = 0.28125
        float3 xformOp:rotateXYZ = (38.4268, 0, 0)
        double3 xformOp:translate = (0, -2, 2.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Mesh "Plane"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 3, 2]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (-1, 1, 0), (1, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def DistantLight "Distant"
    {
        float inputs:angle = 0
        color3f inputs:color = (0, 1, 0)
        float inputs:intensity = 1.5
    }

    def RectLight "Area"
    {
        color3f inputs:color = (1, 0, 0)
        bool inputs:normalize = 1
        double3 xformOp:translate = (0, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
