#usda 1.0
(
    subLayers = [@./ies_base.usda@]
)

def Mesh "light" (
    prepend apiSchemas = ["MeshLightAPI", "ShapingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    # Clockwise seen from +Z, so that the quad emits along -Z.
    point3f[] points = [(-0.02, -0.02, 0), (-0.02, 0.02, 0), (0.02, 0.02, 0), (0.02, -0.02, 0)]
    uniform token subdivisionScheme = "none"
    asset inputs:shaping:ies:file = @./textures/ies/asymmetric.ies@
    double3 xformOp:translate = (0, 0, 1)
    float xformOp:rotateZ = 30
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
}
