#usda 1.0
(
    doc = """Floor of ies_base.usda lit by rect lights with shaping attributes:
    authored without applying ShapingAPI (which usdImaging still reads), and a
    soft 180 degree cone."""
    subLayers = [@./ies_base.usda@]
)

def RectLight "light"
{
    float inputs:height = 0.2
    float inputs:intensity = 50
    float inputs:shaping:cone:angle = 30
    float inputs:shaping:focus = 3
    float inputs:width = 0.2
    double3 xformOp:translate = (-0.8, 0, 1)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def SphereLight "soft_cone" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
    float inputs:intensity = 20
    float inputs:radius = 0.05
    float inputs:shaping:cone:angle = 180
    float inputs:shaping:cone:softness = 0.8
    double3 xformOp:translate = (0.6, 0.3, 0.6)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
