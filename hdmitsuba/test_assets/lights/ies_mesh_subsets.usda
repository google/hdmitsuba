#usda 1.0
(
    subLayers = [@./ies_base.usda@]
)

def Mesh "light" (
    prepend apiSchemas = ["MeshLightAPI", "ShapingAPI"]
)
{
    # The quad of `ies_mesh.usda`, split into two triangles bound to different
    # materials, each of which gets its own emitter.
    int[] faceVertexCounts = [3, 3]
    int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
    # Clockwise seen from +Z, so that the quad emits along -Z.
    point3f[] points = [(-0.02, -0.02, 0), (-0.02, 0.02, 0), (0.02, 0.02, 0), (0.02, -0.02, 0)]
    uniform token subdivisionScheme = "none"
    asset inputs:shaping:ies:file = @./textures/ies/asymmetric.ies@
    double3 xformOp:translate = (0, 0, 1)
    float xformOp:rotateZ = 30
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

    def GeomSubset "subset0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token elementType = "face"
        uniform token familyName = "materialBind"
        int[] indices = [0]
        rel material:binding = </material0>
    }

    def GeomSubset "subset1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token elementType = "face"
        uniform token familyName = "materialBind"
        int[] indices = [1]
        rel material:binding = </material1>
    }
}

def Material "material0"
{
}

def Material "material1"
{
}
