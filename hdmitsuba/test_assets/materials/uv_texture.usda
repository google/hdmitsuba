#usda 1.0
(
    defaultPrim = "root"
    upAxis = "Z"
)

def Xform "root"
{
    def Scope "Camera"
    {
        def Camera "Camera"
        {
            float focalLength = 0.036
            float horizontalAperture = 0.036
            float verticalAperture = 0.0252
            double3 xformOp:translate = (0, 0, 3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 0.6
    }

    def DistantLight "KeyLight"
    {
        float inputs:angle = 2
        float inputs:intensity = 1.5
        float3 xformOp:rotateXYZ = (25, -20, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Scope "_materials"
    {
        class Material "_Preview"
        {
            token outputs:surface.connect = </root/_materials/_Preview/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/uv_quadrants.png@
            }
        }

        # Explicit sourceColorSpace = "raw" on color input + "sRGB" on scalar.
        def Material "colorspace_overrides" (inherits = </root/_materials/_Preview>)
        {
            over "Shader"
            {
                color3f inputs:diffuseColor.connect = </root/_materials/colorspace_overrides/Tex.outputs:rgb>
                float inputs:roughness.connect = </root/_materials/colorspace_overrides/TexSrgb.outputs:r>
                float inputs:metallic = 0.8
            }
            over "Tex"
            {
                token inputs:sourceColorSpace = "Raw"
                float3 outputs:rgb
            }
            def Shader "TexSrgb"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/albedo.png@
                token inputs:sourceColorSpace = "srgb"
                float outputs:r
            }
        }

        class Material "_PreviewXf" (inherits = </root/_materials/_Preview>)
        {
            over "Shader"
            {
                color3f inputs:diffuseColor = (0, 0, 0)
                float inputs:specular = 0
                color3f inputs:emissiveColor.connect = </root/_materials/_PreviewXf/Tex.outputs:rgb>
            }
            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Xf"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </root/_materials/_PreviewXf/St.outputs:result>
                float2 outputs:result
            }
            over "Tex"
            {
                float2 inputs:st.connect = </root/_materials/_PreviewXf/Xf.outputs:result>
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        # 90-deg CCW rotation + translation around USD bottom-left UV origin,
        # colorSpace metadata, and unauthored wrapS falling back to wrapT.
        def Material "rotate_translate" (inherits = </root/_materials/_PreviewXf>)
        {
            over "Xf"
            {
                float inputs:rotation = 90
                float2 inputs:translation = (1.3, 0.25)
            }
            over "Tex"
            {
                asset inputs:file = @./textures/uv_quadrants.png@ (colorSpace = "lin_rec709_scene")
            }
        }

        # Chained UsdTransform2d nodes + wrapS = "useMetadata" -> wrapT.
        def Material "chained_xf" (inherits = </root/_materials/_PreviewXf>)
        {
            def Shader "XfInner"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </root/_materials/chained_xf/St.outputs:result>
                float2 inputs:scale = (2, 1.5)
                float2 inputs:translation = (0.15, 0.25)
                float2 outputs:result
            }
            over "Xf"
            {
                float2 inputs:in.connect = </root/_materials/chained_xf/XfInner.outputs:result>
                float inputs:rotation = 35
                float2 inputs:translation = (-0.2, 0.1)
            }
            over "Tex"
            {
                token inputs:wrapS = "useMetadata"
            }
        }

        # Concrete wrapS ("mirror") overrides conflicting wrapT ("clamp").
        def Material "wrap_s_precedence" (inherits = </root/_materials/_PreviewXf>)
        {
            over "Xf"
            {
                float2 inputs:scale = (2.5, 2.5)
                float2 inputs:translation = (-0.25, -0.25)
            }
            over "Tex"
            {
                string inputs:wrapS = "mirror"
            }
        }
    }

    class Mesh "_Tile" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "faceVarying")
        uniform token subdivisionScheme = "none"
    }
    def Mesh "Tile1" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/colorspace_overrides>
        point3f[] points = [(-1.25, 0.05, 0), (-0.05, 0.05, 0), (-0.05, 0.95, 0), (-1.25, 0.95, 0)]
    }
    def Mesh "Tile2" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/rotate_translate>
        point3f[] points = [(0.05, 0.05, 0), (1.25, 0.05, 0), (1.25, 0.95, 0), (0.05, 0.95, 0)]
    }
    def Mesh "Tile3" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/chained_xf>
        point3f[] points = [(-1.25, -0.95, 0), (-0.05, -0.95, 0), (-0.05, -0.05, 0), (-1.25, -0.05, 0)]
    }
    def Mesh "Tile4" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/wrap_s_precedence>
        point3f[] points = [(0.05, -0.95, 0), (1.25, -0.95, 0), (1.25, -0.05, 0), (0.05, -0.05, 0)]
    }
}
