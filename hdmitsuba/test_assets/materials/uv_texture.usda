#usda 1.0
(
    defaultPrim = "root"
    upAxis = "Z"
)

def Xform "root"
{
    def Scope "Camera"
    {
        def Camera "Camera"
        {
            float focalLength = 0.036
            float horizontalAperture = 0.036
            float verticalAperture = 0.0252
            double3 xformOp:translate = (0, 0, 3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def DomeLight "Sky"
    {
    }

    def Scope "_materials"
    {
        class Material "_Preview"
        {
            token outputs:surface.connect = </root/_materials/_Preview/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/uv_quadrants.png@
            }
        }

        # Shared RGBA texture driving color (.r, auto sRGB) and scalar (.g, .b,
        # auto raw) inputs, plus single-channel normal rejection.
        def Material "preview_orm" (inherits = </root/_materials/_Preview>)
        {
            over "Shader"
            {
                color3f inputs:diffuseColor.connect = </root/_materials/preview_orm/Tex.outputs:r>
                float inputs:roughness.connect = </root/_materials/preview_orm/Tex.outputs:g>
                float inputs:metallic.connect = </root/_materials/preview_orm/Tex.outputs:b>
                normal3f inputs:normal.connect = </root/_materials/preview_orm/Tex.outputs:r>
            }
            over "Tex"
            {
                float outputs:r
                float outputs:g
                float outputs:b
            }
        }

        # Explicit sourceColorSpace overrides: "Raw" on color, "srgb" on scalar.
        def Material "colorspace_overrides" (inherits = </root/_materials/_Preview>)
        {
            over "Shader"
            {
                color3f inputs:diffuseColor.connect = </root/_materials/colorspace_overrides/Tex.outputs:r>
                float inputs:roughness.connect = </root/_materials/colorspace_overrides/TexSrgb.outputs:g>
                float inputs:metallic = 0.8
            }
            over "Tex"
            {
                token inputs:sourceColorSpace = "Raw"
                float outputs:r
            }
            def Shader "TexSrgb"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/uv_quadrants.png@
                token inputs:sourceColorSpace = "srgb"
                float outputs:g
            }
        }

        # Native Mitsuba principled driven by NodeGraph passthrough (.b),
        # missing-file fallback (.g), linear .a under "sRGB", and
        # RGB-without-alpha (.a -> 1.0).
        def Material "mitsuba_channels"
        {
            token outputs:mitsuba:surface.connect = </root/_materials/mitsuba_channels/BSDF.outputs:out>
            def Shader "BSDF"
            {
                uniform token info:id = "mitsuba_principled"
                color3f inputs:base_color.connect = </root/_materials/mitsuba_channels/NG.outputs:ch_b>
                float inputs:roughness.connect = </root/_materials/mitsuba_channels/MissingTex.outputs:g>
                float inputs:metallic.connect = </root/_materials/mitsuba_channels/TexRgba.outputs:a>
                float inputs:clearcoat.connect = </root/_materials/mitsuba_channels/TexNoAlpha.outputs:a>
                token outputs:out
            }
            def Shader "TexRgba"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/uv_quadrants.png@
                token inputs:sourceColorSpace = "sRGB"
                float outputs:a
            }
            def Shader "TexNoAlpha"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/albedo.png@
                float outputs:a
            }
            def Shader "MissingTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/does_not_exist.png@
                float4 inputs:fallback = (0.1, 0.75, 0.3, 0.9)
                float outputs:g
            }
            def NodeGraph "NG"
            {
                float outputs:ch_b.connect = </root/_materials/mitsuba_channels/NG/Tex.outputs:b>
                def Shader "Tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./textures/uv_quadrants.png@
                    float outputs:b
                }
            }
        }

        class Material "_PreviewXf" (inherits = </root/_materials/_Preview>)
        {
            over "Shader"
            {
                color3f inputs:diffuseColor = (0, 0, 0)
                float inputs:specular = 0
                color3f inputs:emissiveColor.connect = </root/_materials/_PreviewXf/Tex.outputs:rgb>
            }
            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Xf"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </root/_materials/_PreviewXf/St.outputs:result>
                float2 outputs:result
            }
            over "Tex"
            {
                float2 inputs:st.connect = </root/_materials/_PreviewXf/Xf.outputs:result>
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        # 90-deg CCW rotation + translation around USD bottom-left UV origin,
        # colorSpace metadata, and unauthored wrapS falling back to wrapT.
        def Material "rotate_translate" (inherits = </root/_materials/_PreviewXf>)
        {
            over "Xf"
            {
                float inputs:rotation = 90
                float2 inputs:translation = (1.3, 0.25)
            }
            over "Tex"
            {
                asset inputs:file = @./textures/uv_quadrants.png@ (colorSpace = "lin_rec709_scene")
            }
        }

        # Chained UsdTransform2d nodes + wrapS = "useMetadata" -> wrapT.
        def Material "chained_xf" (inherits = </root/_materials/_PreviewXf>)
        {
            def Shader "XfInner"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </root/_materials/chained_xf/St.outputs:result>
                float2 inputs:scale = (2, 1.5)
                float2 inputs:translation = (0.15, 0.25)
                float2 outputs:result
            }
            over "Xf"
            {
                float2 inputs:in.connect = </root/_materials/chained_xf/XfInner.outputs:result>
                float inputs:rotation = 35
                float2 inputs:translation = (-0.2, 0.1)
            }
            over "Tex"
            {
                token inputs:wrapS = "useMetadata"
            }
        }

        # Concrete wrapS ("mirror") overrides conflicting wrapT ("clamp").
        def Material "wrap_s_precedence" (inherits = </root/_materials/_PreviewXf>)
        {
            over "Xf"
            {
                float2 inputs:scale = (2.5, 2.5)
                float2 inputs:translation = (-0.25, -0.25)
            }
            over "Tex"
            {
                string inputs:wrapS = "mirror"
            }
        }
    }

    class Mesh "_Tile" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "faceVarying")
        uniform token subdivisionScheme = "none"
    }
    def Mesh "Tile1" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/preview_orm>
        point3f[] points = [(-1.45, 0.05, 0), (-0.55, 0.05, 0), (-0.55, 0.95, 0), (-1.45, 0.95, 0)]
    }
    def Mesh "Tile2" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/colorspace_overrides>
        point3f[] points = [(-0.45, 0.05, 0), (0.45, 0.05, 0), (0.45, 0.95, 0), (-0.45, 0.95, 0)]
    }
    def Mesh "Tile3" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/mitsuba_channels>
        point3f[] points = [(0.55, 0.05, 0), (1.45, 0.05, 0), (1.45, 0.95, 0), (0.55, 0.95, 0)]
    }
    def Mesh "Tile4" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/rotate_translate>
        point3f[] points = [(-1.45, -0.95, 0), (-0.55, -0.95, 0), (-0.55, -0.05, 0), (-1.45, -0.05, 0)]
    }
    def Mesh "Tile5" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/chained_xf>
        point3f[] points = [(-0.45, -0.95, 0), (0.45, -0.95, 0), (0.45, -0.05, 0), (-0.45, -0.05, 0)]
    }
    def Mesh "Tile6" (inherits = </root/_Tile>)
    {
        rel material:binding = </root/_materials/wrap_s_precedence>
        point3f[] points = [(0.55, -0.95, 0), (1.45, -0.95, 0), (1.45, -0.05, 0), (0.55, -0.05, 0)]
    }
}
